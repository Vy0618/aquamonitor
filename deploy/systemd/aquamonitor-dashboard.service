[Unit]
Description=AquaMonitor dashboard
After=network.target aquamonitor-api.service
PartOf=aquamonitor.target
StartLimitIntervalSec=0

[Service]
Type=exec
User=vyzxc
WorkingDirectory=/home/vyzxc/aquamonitor
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/vyzxc/aquamonitor/.venv/bin/python /home/vyzxc/aquamonitor/serve_dashboard.py --bind 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=aquamonitor.target
